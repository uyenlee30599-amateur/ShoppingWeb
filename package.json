{
  "name": "boutique-node-assignment03",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:admin\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "vite client --config client/vite.config.js",
    "dev:admin": "vite admin --config admin/vite.config.js",
    "build": "vite build client --config client/vite.config.js && vite build admin --config admin/vite.config.js",
    "start": "node server/src/index.js",
    "seed": "node server/scripts/seed.js",
    "user:role": "node server/scripts/role.js",
    "test": "node --test server/test/*.test.js",
    "lint": "eslint client/src admin/src",
    "format": "prettier --write client/src admin/src server/src server/scripts server/test README.md",
    "dev:local": "node server/scripts/local.js",
    "build:hosted": "vite build client --config client/vite.config.js && ADMIN_BASE=/admin/ vite build admin --config admin/vite.config.js",
    "pretest": "npm run build:hosted"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "mongoose": "^9.10.4",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^14.0.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.6.2",
    "supertest": "^7.3.1",
    "vite": "^8.0.0"
  }
}
